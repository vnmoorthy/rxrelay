# Product mode. Demo mode never dials or texts a real recipient.
TELEPHONY_PROVIDER=demo
ALLOW_LIVE_TELEPHONY=false
PORT=3000

# Set only after your a1mobile team has supplied the real values.
A1MOBILE_MCP_URL=
A1MOBILE_MCP_TOKEN=
A1MOBILE_API_BASE_URL=
A1MOBILE_API_KEY=
A1MOBILE_PHONE_NUMBER=
A1MOBILE_AGENT_ID=
PUBLIC_APP_URL=http://localhost:3000
A1MOBILE_WEBHOOK_SECRET=
A1MOBILE_WEBHOOK_SIGNATURE_HEADER=x-a1mobile-signature
A1MOBILE_WEBHOOK_TIMESTAMP_HEADER=x-a1mobile-timestamp

# PAVO-backed OpenAI-compatible inference configuration.
PAVO_OPENAI_BASE_URL=
PAVO_OPENAI_API_KEY=
PAVO_FAST_MODEL=
PAVO_STRONG_MODEL=

# Comma-separated OTP-verified, consented demo recipients. Required for live mode.
DEMO_ALLOWED_RECIPIENTS=
REQUIRE_EXPLICIT_CONTACT_CONSENT=true
