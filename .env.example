# Product mode. Demo mode never dials or texts a real recipient.
TELEPHONY_PROVIDER=demo
ALLOW_LIVE_TELEPHONY=false
PORT=3000

# Set only after your a1mobile team has supplied the real values.
A1MOBILE_MCP_URL=
A1MOBILE_MCP_TOKEN=
A1MOBILE_API_BASE_URL=https://hack.a1mobile.com
A1MOBILE_API_KEY=
A1MOBILE_TEAM_KEY=
A1MOBILE_PHONE_NUMBER=
A1MOBILE_AGENT_ID=
PUBLIC_APP_URL=http://localhost:3000
A1MOBILE_WEBHOOK_SECRET=
A1MOBILE_WEBHOOK_SIGNATURE_HEADER=x-a1mobile-signature
A1MOBILE_WEBHOOK_TIMESTAMP_HEADER=x-a1mobile-timestamp
# Provider-specific action URLs supplied by the hack portal/integration.
# RxRelay sends signed JSON action payloads to these URLs and fails closed if
# either is absent or the response has no provider-issued action id.
A1MOBILE_CALL_ACTION_URL=
A1MOBILE_TEXT_ACTION_URL=
A1MOBILE_SMS_URL=https://hack.a1mobile.com/api/sms
A1MOBILE_COORDINATION_RECIPIENT=
A1MOBILE_API_AUTH_HEADER=authorization
A1MOBILE_API_AUTH_PREFIX=Bearer

# PAVO-backed OpenAI-compatible inference (official a1mobile chat gateway).
# Prefer sol for voice quality. Optional PAVO_CHAT_MODEL=openai.gpt-5.6-luna for open chat.
PAVO_OPENAI_BASE_URL=https://hack.a1mobile.com/gw/v1
PAVO_OPENAI_API_KEY=
PAVO_FAST_MODEL=openai.gpt-5.6-sol
PAVO_STRONG_MODEL=openai.gpt-5.6-sol
# PAVO_CHAT_MODEL=openai.gpt-5.6-luna


# Isolated inbound TeXML voice gateway (keep separate from the dashboard).
VOICE_PORT=3001
VOICE_HOST=127.0.0.1
VOICE_WEBHOOK_TOKEN=
# Shared case store used by both server.mjs and voice-server.mjs.
RXRELAY_STORE_PATH=
# Optional override for the Cloudflare quick-tunnel binary.
CLOUDFLARED_BIN=/tmp/rxrelay-cloudflared/cloudflared

# Comma-separated OTP-verified, consented demo recipients. Required for live mode.
# Required in live mode: comma-separated, OTP-verified test numbers only.
LIVE_ALLOWED_RECIPIENTS=
DEMO_ALLOWED_RECIPIENTS=
REQUIRE_EXPLICIT_CONTACT_CONSENT=true
